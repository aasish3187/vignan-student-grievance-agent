# =====================================================================
# Agent 46: Environment Variables & Campus Database Configuration
# =====================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production

# 2. Supabase (Managed PostgreSQL) Database Connection
# When set, Agent 46 automatically connects to your cloud Supabase database.
# When omitted, Agent 46 seamlessly runs on local SQLite (grievance.db).
#
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# (Use Connection Pooler on port 6543 with pgbouncer=true for optimal performance)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 3. Optional Direct Supabase Credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# 4. Automated Background Server-to-Phone WhatsApp Dispatch (Optional)
# Choose Method A (Twilio) OR Method B (CallMeBot free):
#
# Method A: Twilio WhatsApp Sandbox / Business API (Official multi-user sandbox)
# 1. Get credentials from: https://console.twilio.com/
# 2. Join sandbox by sending the code (e.g. "join simple-zebra") to +1 415 523 8886 from your phone.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# Method B: CallMeBot Free WhatsApp API (Alternative 30-second setup, 100% free)
# 1. From WhatsApp, send: "I allow callmebot to send me messages" to +34 941 01 99 65
# 2. CallMeBot replies with your API key.
# CALLMEBOT_APIKEY=123456

# Method C: Official Meta WhatsApp Business Cloud API (Direct University Meta Account)
# 1. Get credentials from Meta for Developers: https://developers.facebook.com/
# 2. Add System User Permanent Token and Registered Phone Number ID:
META_WHATSAPP_TOKEN=EAAG...
META_PHONE_NUMBER_ID=100xxxxxxxxxxxx

