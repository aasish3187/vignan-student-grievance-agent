# =====================================================================
# Agent 46: Environment Variables & Campus Database Configuration
# =====================================================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production

# 2. Supabase (Managed PostgreSQL) Database Connection
# When set, Agent 46 automatically connects to your cloud Supabase database.
# When omitted, Agent 46 seamlessly runs on local SQLite (grievance.db).
#
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# (Use Connection Pooler on port 6543 with pgbouncer=true for optimal performance)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 3. Optional Direct Supabase Credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
